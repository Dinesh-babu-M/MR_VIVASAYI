# =============================================================
#  MR. VIVASAYI — Environment Variables Template (.env.example)
#  Copy this file to `.env` and configure your credentials.
#  NEVER commit your actual `.env` file to version control.
# =============================================================

# Database Configuration
# Set to 'true' to use live Supabase PostgreSQL, or 'false' for offline JSON store
VITE_DATABASE_MODULE=true
VITE_DATA_SOURCE=supabase

# Supabase Public Client Credentials (Safe for browser / client build)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
VITE_SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Server-Side / Node.js Scripts Only (NEVER prefix with VITE_ to prevent client bundle exposure)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Store Branding & Application Metadata
VITE_APP_NAME=MR. VIVASAYI
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://mrvivasayi.in

# Contact & WhatsApp Channels
VITE_WHATSAPP_NUMBER=919876543210
VITE_WHATSAPP_ORDERS_NUMBER=919876543210
VITE_WHATSAPP_SUPPORT_NUMBER=919876543210
VITE_SUPPORT_EMAIL=hello@mrvivasayi.in

# WhatsApp Business Cloud API (Optional - for direct graph api notifications)
VITE_WHATSAPP_ACCESS_TOKEN=
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Payment UPI Settings
VITE_UPI_ID=mrvivasayi@upi
VITE_UPI_PAYEE_NAME=MR. VIVASAYI Organic Foods

# Staff & Security Defaults
VITE_DEFAULT_STAFF_PASSWORD=@@12345678@@

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_WHATSAPP_CHAT=true
